[Unit]
Description=Android Auto Bluetooth start-up (wireless AA hand-off)
After=bluetooth.service aa-hostapd.service
Requires=bluetooth.service

[Service]
EnvironmentFile=-/etc/beagle-aa-bridge/env
Environment=AA_NO_TCP=1
# BlueZ re-creates its core SDP records on start; Android rejects them (16-bit UUIDs encoded as 128-bit)
ExecStartPre=/bin/bash -c 'sleep 2; for h in 0x10000 0x10001 0x10002 0x10003; do sdptool del $h >/dev/null 2>&1; done; hciconfig hci0 up || true'
WorkingDirectory=/opt/beagle-aa-bridge
ExecStart=/usr/bin/python3 /opt/beagle-aa-bridge/src/aa_bt.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/aa_bt.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
